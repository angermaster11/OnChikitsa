# ─────────────────────────────────────────────────────────────────────────────
# OnChikitsa backend — environment template
# Copy to `.env` (backend-local) or set these in the monorepo root `.env`.
# NEVER commit a real .env. All secrets below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────────────────────────
# A standalone mongod works; transactions degrade gracefully (see README).
# For full transaction support use a replica set, e.g.
#   mongodb://localhost:27017/onchikitsa?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/onchikitsa
# Optional: the app's own db name inside the cluster (overrides any db in the URI).
# MONGODB_DB_NAME=onchikitsa
# Connection-pool bounds per process. Size so (max × instances) stays under the
# cluster's connection limit when running multiple replicas behind a load balancer.
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=5

# ── JWT (staff auth: SUPER_ADMIN / ADMIN / SUPPORT) ───────────────────────────
# Use long random strings (>= 32 chars). Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Firebase Admin SDK (app auth: USER / CLINIC phone-OTP tokens) ─────────────
# Optional locally — if unset the server still boots for admin-only work, but
# USER/CLINIC endpoints return an auth error. Escape newlines in the private key
# as literal \n (they are un-escaped at load time).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Super Admin bootstrap (npm run seed:superadmin) ───────────────────────────
# Required by the seed script. The password is hashed with Argon2id before store;
# it is NEVER persisted in plaintext and should be rotated after first login.
SUPER_ADMIN_EMAIL=superadmin@onchikitsa.local
SUPER_ADMIN_PASSWORD=change-me-strong-password
SUPER_ADMIN_NAME=Super Admin

# ── HTTP / security ───────────────────────────────────────────────────────────
# Comma-separated allowed origins. '*' allows any origin but then credentials are
# disabled (safe). In production set this to your admin-panel origin(s), e.g.
#   CORS_ORIGIN=https://admin.onchikitsa.com
CORS_ORIGIN=*
BODY_LIMIT=1mb
# Express 'trust proxy'. Set to the REAL number of proxy hops in front of the app
# (e.g. 1 behind a single nginx/ingress), or 'false' if none. Prevents clients from
# spoofing X-Forwarded-For to bypass the IP-keyed rate limiter.
TRUST_PROXY=1

# ── Auth hardening ────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Scaling / Redis (optional) ────────────────────────────────────────────────
# Leave UNSET for local dev / a single instance — the app then uses in-process
# state and runs exactly as before. Set it to run MULTIPLE instances behind a load
# balancer: the rate limiter then shares its counters across instances via Redis.
# Size MONGODB_MAX_POOL_SIZE so (pool × instances) stays under the DB connection cap.
# REDIS_URL=redis://127.0.0.1:6379

# ── Razorpay (payments + Route split payouts) — optional service ──────────────
# Mirrors the Cloudinary optional-guard: payments/onboarding return 503
# PAYMENT_NOT_CONFIGURED until KEY_ID + KEY_SECRET are set. Use rzp_test_ keys in
# development. WEBHOOK_SECRET must match the secret on the Razorpay Dashboard
# webhook; it is checked only by the webhook route, not for order/onboarding.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── PayU (alternative per-clinic gateway) — optional service ──────────────────
# A clinic can be switched to PayU from the admin panel (Payment Modes). PayU is
# a PAYOUT model, not a split: the platform collects the full amount via PayU
# hosted checkout, then disburses the clinic's share to the UPI ID / bank the
# admin saved for that clinic. Two independent capabilities, each guarded like
# Razorpay above (a missing set → 503 until filled):
#   COLLECTION (hosted checkout): PAYU_MERCHANT_KEY + PAYU_MERCHANT_SALT
#   PAYOUTS (disburse to the clinic): PAYU_CLIENT_ID + PAYU_CLIENT_SECRET
#                                     + PAYU_AUTH_URL + PAYU_PAYOUT_URL
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
# test → PayU sandbox endpoints, live → production. Default: test.
PAYU_MODE=test
# Payouts API endpoints (OAuth token + single transfer). Fill from your PayU
# Payouts dashboard; required only when using PayU payouts.
PAYU_AUTH_URL=
PAYU_PAYOUT_URL=

# Public origin PayU redirects back to and the in-app browser opens (surl/furl +
# the /api/v1/payu/checkout page). Must be reachable from the device — a public
# HTTPS URL in production, or your ngrok tunnel in development. Falls back to
# NGROK_URL, then http://localhost:PORT.
PUBLIC_BASE_URL=

